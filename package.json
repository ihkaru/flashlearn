{
  "name": "flashlearn-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter ./apps/api dev & bun --filter ./apps/web dev",
    "dev:api": "bun --filter ./apps/api dev",
    "dev:web": "bun --filter ./apps/web dev",
    "build": "bun --filter \"*\" build",
    "test": "bun test",
    "cli": "bun run ./packages/cli/src/index.ts",
    "lint:srp": "bun run scripts/check_srp_limits.ts",
    "lint:arc42": "arc42-lint docs/architecture",
    "lint:arc42:strict": "arc42-lint docs/architecture --strict",
    "audit:stories": "python3 scripts/audit_story_gap.py",
    "audit:domain": "bun run scripts/audit_domain_curriculum.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
