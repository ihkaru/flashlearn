{
  "name": "flashlearn-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' --parallel --no-exit-on-error dev",
    "dev:db": "docker compose -f compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f compose.dev.yml down",
    "dev:setup": "bun run dev:db && bun --filter @flashlearn/api db:migrate && bun --filter @flashlearn/api db:seed",
    "dev:up": "bun run dev:setup && bun run dev",
    "dev:api": "bun --filter ./apps/api dev",
    "dev:web": "bun --filter ./apps/web dev",
    "build": "bun --filter \"*\" build",
    "test": "bun test",
    "cli": "bun run ./packages/cli/src/index.ts",
    "lint:srp": "bun run scripts/check_srp_limits.ts",
    "lint:arc42": "arc42-lint docs/architecture",
    "lint:arc42:strict": "arc42-lint docs/architecture --strict",
    "audit:stories": "python3 scripts/audit_story_gap.py",
    "audit:domain": "bun run scripts/audit_domain_curriculum.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "uuid": "^11.1.1"
  }
}
