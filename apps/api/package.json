{
  "name": "@flashlearn/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "db:migrate": "bun run src/infrastructure/database/migrate.ts",
    "db:push": "bun run drizzle-kit push",
    "db:generate": "bun run drizzle-kit generate",
    "db:seed": "bun run src/infrastructure/database/seed.ts",
    "worker": "bun src/worker.ts",
    "worker:once": "bun src/worker.ts --once"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@flashlearn/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.9",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.0"
  }
}
