PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/flashlearn
JWT_SECRET=your-secure-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPERADMIN_EMAILS=superadmin@example.com

# AI API Gateway (OpenAI-compatible: Lumis AI Gateway, 9router, OpenRouter, OpenAI, vLLM)
AI_GATEWAY_URL=https://router.dvlpid.my.id/v1
AI_GATEWAY_KEY=your-9router-or-openai-compatible-key
AI_DEFAULT_MODEL=my9model-free
AI_FAST_MODEL=my9model-fast
AI_SMART_MODEL=my9model-smart
AI_TIMEOUT_MS=45000

# Optional Persistent Media Asset Storage (default: postgres — stateless zero-config, survives container redeploys)
# ASSET_STORAGE_DRIVER=postgres # options: postgres | local | mediavault
# ASSET_STORAGE_DIR=./data/assets # used only when ASSET_STORAGE_DRIVER=local
# ASSET_MAX_BYTES=10485760 # default 10 MB
# MEDIAVAULT_URL=https://media.example.com # opt-in only when ASSET_STORAGE_DRIVER=mediavault
# MEDIAVAULT_API_KEY=your-mediavault-api-key
